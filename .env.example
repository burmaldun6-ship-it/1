# Telegram BotFather token
BOT_TOKEN=

# ID владельца/администратора Telegram
ADMIN_ID=

# OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# SQLite path. On WispByte choose a persistent server path if your plan/image provides one.
DATABASE_PATH=data/bot.sqlite3

# Default daily successful-complaint limit
DEFAULT_DAILY_LIMIT=5
